"big pharma","gouvernement cache","médias mentent","preuve irréfutable",
"ce qu'on vous cache","révélation exclusive","censuré","interdit","vérité cachée"
];

const motsScientifiques = [
"selon l'oms","selon l'onu","selon les scientifiques","étude publiée","peer review",
"université","données officielles","selon reuters","selon afp","rapport officiel",
"ministère","haute autorité de santé","académie de médecine","journal officiel"
];

// ════════════════════════════════════════════════════════
// ÉTAPE 1 : WIKIPEDIA API (sans clé, CORS friendly)
// ════════════════════════════════════════════════════════
async function checkWikipedia(text) {
const result = { found: false, extract: '', score: 0, matchedTerms: [], url: '' };

// Extrait les mots significatifs du texte (> 3 lettres, pas stopwords)
const stopWords = new Set(['dans','avec','pour','que','qui','une','des','les','est','par',
'sur','pas','plus','très','mais','été','aussi','cette','tout','comme','bien','même',
'leur','leurs','ont','sont','être','fait','dit','elle','lui','ils','nous','vous']);
const words = text.toLowerCase()
.replace(/[^\wÀ-ÿ\s]/g, ' ')
.split(/\s+/)
.filter(w => w.length > 3 && !stopWords.has(w));

if (words.length === 0) return result;

// Cherche d'abord la phrase entière, puis les entités
const queries = [
text.substring(0, 100),
words.slice(0, 4).join(' '),
words.slice(0, 3).join(' ')
];

for (const q of queries) {
if (!q.trim()) continue;
try {
// Recherche sur Wikipédia FR
const searchUrl = `https://fr.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(q)}&srlimit=1&format=json&origin=*`;
const searchRes = await fetch(searchUrl);
const searchData = await searchRes.json();
const pages = searchData.query?.search || [];
if (pages.length === 0) continue;

const pageTitle = pages[0].title;

// Récupère l'extrait de la page
const extractUrl = `https://fr.wikipedia.org/w/api.php?action=query&titles=${encodeURIComponent(pageTitle)}&prop=extracts&exintro=true&explaintext=true&exsentences=5&format=json&origin=*`;
const extractRes = await fetch(extractUrl);
const extractData = await extractRes.json();
const page = Object.values(extractData.query.pages)[0];
if (!page || !page.extract) continue;

const extract = page.extract;
const extractLower = extract.toLowerCase();

// Compte combien de mots du texte original se retrouvent dans l'extrait Wikipedia
const textWords = text.toLowerCase()
.replace(/[^\wÀ-ÿ\s]/g, ' ')
.split(/\s+/)
.filter(w => w.length > 3 && !stopWords.has(w));

const matched = textWords.filter(w => extractLower.includes(w));
const matchRatio = textWords.length > 0 ? matched.length / textWords.length : 0;

if (matchRatio > 0.2 || matched.length >= 2) {
result.found = true;
result.extract = extract.substring(0, 300) + (extract.length > 300 ? '…' : '');
result.matchedTerms = matched;
result.score = Math.round(40 + matchRatio * 55); // 40-95
result.url = `https://fr.wikipedia.org/wiki/${encodeURIComponent(pageTitle)}`;
result.pageTitle = pageTitle;

// Vérif de contradiction : y a-t-il des affirmations dans le texte qui contredisent Wikipedia ?
result.score = checkContradictions(text, extract, result.score);
break;
}
} catch (e) {
console.warn('Wikipedia error:', e);
}
}
return result;
}

// Détecte les contradictions entre le texte soumis et l'extrait Wikipedia
function checkContradictions(text, wikiExtract, baseScore) {
const tl = text.toLowerCase();
const wl = wikiExtract.toLowerCase();
let score = baseScore;

// Paires pays/ville souvent dans les fake news (ex: "Tour Eiffel à Berlin")
const locations = [
['paris','france'], ['berlin','allemagne'], ['madrid','espagne'],
['rome','italie'], ['londres','royaume-uni'], ['washington','états-unis'],
['moscou','russie'], ['pékin','chine'], ['tokyo','japon']
];

for (const [city, country] of locations) {
// Si le texte mentionne la ville ET le wiki confirme le bon pays
if (tl.includes(city) && wl.includes(city)) {
// Check si le texte dit un mauvais pays
for (const [, wrongCountry] of locations) {
if (wrongCountry !== country && tl.includes(wrongCountry) && !wl.includes(wrongCountry)) {
score = Math.min(score, 20); // Contradiction détectée → score très bas
}
}
}
}

// Noms de personnes + rôles
const roles = ['président','premier ministre','roi','reine','chancelier','directeur','fondateur'];
for (const role of roles) {
if (tl.includes(role) && wl.includes(role)) {
score = Math.min(score + 5, 95); // Rôle confirmé
}
}

return score;
}

// ════════════════════════════════════════════════════════
// ÉTAPE 2 : GOOGLE FACT CHECK API
// ════════════════════════════════════════════════════════
async function checkFactCheck(query) {
let claims = [];
try {
const r = await fetch(
`https://factchecktools.googleapis.com/v1alpha1/claims:search?query=${encodeURIComponent(query)}&key=${GOOGLE_KEY}&languageCode=fr`
);
const d = await r.json();
claims = d.claims || [];
if (claims.length === 0) {
const r2 = await fetch(
`https://factchecktools.googleapis.com/v1alpha1/claims:search?query=${encodeURIComponent(query)}&key=${GOOGLE_KEY}`
);
const d2 = await r2.json();
claims = d2.claims || [];
}
} catch (e) { console.warn('Fact Check error:', e); }

// Calcule un score à partir des résultats
let factScore = null;
for (const claim of claims.slice(0, 3)) {
const rating = (claim.claimReview?.[0]?.textualRating || '').toLowerCase();
if (/faux|false|fake|incorrect|misleading|infondé|erroné/.test(rating)) {
factScore = factScore === null ? 10 : Math.min(factScore, 10);
} else if (/vrai|true|correct|accurate|confirmé|vérifié/.test(rating)) {
factScore = factScore === null ? 90 : Math.max(factScore, 90);
}
}
return { claims: claims.slice(0, 3), factScore };
}

// ════════════════════════════════════════════════════════
// ÉTAPE 3 : ANALYSE SÉMANTIQUE LOCALE
// ════════════════════════════════════════════════════════
function analyseLocale(text) {
const tl = text.toLowerCase();
let score = 50;
let indicators = [];
let analyse = '';
let theorieTrouvee = false;
let searchQuery = text.substring(0, 80);

// Théories connues
for (const t of theoriesToConnues) {
if (t.mots.filter(m => tl.includes(m)).length >= 2) {
score = t.score;
analyse = t.analyse;
searchQuery = t.q;
theorieTrouvee = true;
indicators.push('⚠️ Théorie infirmée par la communauté scientifique');
indicators.push('❌ Affirmation contredite par le consensus scientifique');
break;
}
}

if (!theorieTrouvee) {
let cntD = 0, dList = [];
for (const m of motsDouteux) {
if (tl.includes(m)) { cntD++; dList.push(m); }
}
let cntS = 0;
for (const m of motsScientifiques) {
if (tl.includes(m)) cntS++;
}

score = 50 - (cntD * 12) + (cntS * 10);

if (text.length < 20) { score -= 15; indicators.push('⚠️ Texte trop court pour une analyse complète'); }
if ((text.match(/[A-ZÀÂÉÈÊËÏÎÔÙÛÜ]{3,}/g) || []).length > 2) {
score -= 8; indicators.push('⚠️ Usage excessif de majuscules (style alarmiste)');
}
if ((text.match(/!/g) || []).length > 1) {
score -= 5; indicators.push('⚠️ Langage émotionnel et alarmiste détecté');
}
if (dList.length > 0) {
indicators.push(`⚠️ Langage sensationnaliste : "${dList.slice(0,2).join('", "')}"`);
}
if (cntS > 0) {
indicators.push('✅ Référence à des sources ou institutions officielles');
} else if (cntD === 0) {
indicators.push('🔵 Langage neutre — pas de marqueur alarmiste');
}

if (cntD > 3) {
analyse = 'Ce texte contient de nombreux marqueurs typiques de la désinformation : langage alarmiste, appel à l\'émotion et absence de sources vérifiables.';
} else if (cntD > 1) {
analyse = 'Ce texte présente des formulations sensationnalistes et n\'indique pas de sources officielles. Vérification recommandée.';
} else if (cntS > 1) {
analyse = 'Ce texte mentionne des institutions officielles, ce qui est un bon indicateur. Consultez directement ces sources pour confirmer.';
} else {
analyse = 'Aucun marqueur évident de désinformation détecté. Résultat basé sur la vérification Wikipedia et Google Fact Check.';
}
}

return {
localScore: Math.max(5, Math.min(95, score)),
indicators,
analyse,
searchQuery
};
}

// ════════════════════════════════════════════════════════
// FUSION DES SCORES
// ════════════════════════════════════════════════════════
function fuseScores(localScore, wikiResult, factCheckScore) {
let score = localScore;
let sourceWeights = [];

// Wikipedia a le plus grand poids si une page est trouvée
if (wikiResult.found) {
score = Math.round(wikiResult.score * 0.6 + localScore * 0.4);
sourceWeights.push(`Wikipedia (60%)`);
}

// Google Fact Check écrase si une vérification formelle existe
if (factCheckScore !== null) {
if (wikiResult.found) {
score = Math.round(factCheckScore * 0.5 + wikiResult.score * 0.35 + localScore * 0.15);
} else {
score = Math.round(factCheckScore * 0.6 + localScore * 0.4);
}
sourceWeights.push(`Fact Check (prioritaire)`);
}

return Math.max(3, Math.min(97, score));
}

// ════════════════════════════════════════════════════════
// ANALYSE PRINCIPALE
// ════════════════════════════════════════════════════════
async function analyzeText() {
const text = document.getElementById('inputText').value.trim();
if (!text) { alert('Veuillez entrer un texte à analyser.'); return; }

const btn = document.getElementById('btnAnalyze');
btn.disabled = true;
btn.textContent = 'Analyse en cours…';
document.getElementById('loading').classList.add('show');
document.getElementById('results').classList.remove('show');

// Réinitialise les étapes
['step1','step2','step3','step4'].forEach(id => {
const el = document.getElementById(id);
el.classList.remove('active','done');
});

function setStep(n) {
if (n > 1) document.getElementById(`step${n-1}`).classList.replace('active','done');
document.getElementById(`step${n}`).classList.add('active');
}

// Analyse locale (immédiate)
const local = analyseLocale(text);

// Étape 1 : Wikipedia
setStep(1);
const wikiResult = await checkWikipedia(text);

// Étape 2 : Google Fact Check
setStep(2);
const { claims, factScore } = await checkFactCheck(local.searchQuery);

// Étape 3 : Analyse sémantique
setStep(3);
await new Promise(r => setTimeout(r, 400));

// Étape 4 : Score final
setStep(4);
await new Promise(r => setTimeout(r, 300));
document.getElementById('step4').classList.replace('active','done');

const finalScore = fuseScores(local.localScore, wikiResult, factScore);

// Affichage
displayResults({ finalScore, local, wikiResult, claims, factScore });

document.getElementById('loading').classList.remove('show');
btn.disabled = false;
btn.textContent = 'Analyser';
}

// ════════════════════════════════════════════════════════
// AFFICHAGE
// ════════════════════════════════════════════════════════
function displayResults({ finalScore, local, wikiResult, claims, factScore }) {
const score = finalScore;
let riskLevel, riskClass;
if (score <= 30) { riskLevel = 'Risque Très Élevé'; riskClass = 'risk-high'; }
else if (score <= 50) { riskLevel = 'Risque Élevé'; riskClass = 'risk-high'; }
else if (score <= 70) { riskLevel = 'Risque Modéré'; riskClass = 'risk-medium'; }
else { riskLevel = 'Fiable'; riskClass = 'risk-low'; }

// Score card
document.getElementById('scoreCard').className = `result-card score-card ${riskClass}`;
document.getElementById('riskLabel').textContent = riskLevel;
document.getElementById('riskScore').textContent = score + ' / 100';
document.getElementById('iaText').textContent = local.analyse;

// Sources utilisées
const srcs = [];
if (wikiResult.found) srcs.push('📖 Wikipedia');
if (claims.length > 0) srcs.push('📋 Google Fact Check');
srcs.push('🧠 Analyse sémantique');
document.getElementById('sourcesUsed').textContent = '🔵 Sources croisées : ' + srcs.join(' · ');

// Wikipedia card
const wikiCard = document.getElementById('wikiCard');
if (wikiResult.found) {
wikiCard.style.display = '';
let extract = wikiResult.extract;
// Surligne les mots matchés
wikiResult.matchedTerms.slice(0, 5).forEach(term => {
const re = new RegExp(`(${term})`, 'gi');
extract = extract.replace(re, '<mark>$1</mark>');
});
document.getElementById('wikiExtract').innerHTML =
`<strong><a href="${wikiResult.url}" target="_blank" style="color:var(--green);text-decoration:none">📖 ${wikiResult.pageTitle}</a></strong><br><br>${extract}`;
const bar = document.getElementById('wikiBar');
const wikiColor = wikiResult.score >= 70 ? '#10b981' : wikiResult.score >= 50 ? '#f59e0b' : '#ef4444';
bar.style.background = wikiColor;
setTimeout(() => { bar.style.width = wikiResult.score + '%'; }, 100);
} else {
wikiCard.style.display = 'none';
}

// Fact check sources
const srcList = document.getElementById('sourcesList');
srcList.innerHTML = '';
if (claims.length > 0) {
claims.forEach(claim => {
const review = claim.claimReview?.[0];
if (!review) return;
const rating = review.textualRating || '';
const isFalse = /faux|false|fake|incorrect|misleading/i.test(rating);
const isTrue = /vrai|true|correct|accurate/i.test(rating);
const rBg = isFalse ? '#FEE2E2' : isTrue ? '#D1FAE5' : '#FEF9C3';
const rColor = isFalse ? '#991B1B' : isTrue ? '#065F46' : '#92400E';
const txt = (claim.text || review.title || 'Voir la vérification').substring(0, 75) + '…';
const div = document.createElement('div');
div.className = 'source-item';
div.innerHTML = `
<a href="${review.url || '#'}" target="_blank" rel="noopener">
→ ${review.publisher?.name ? `<strong>${review.publisher.name}</strong> : ` : ''}${txt}
${rating ? `<span class="source-rating" style="background:${rBg};color:${rColor}">${rating}</span>` : ''}
</a>
${claim.claimant ? `<div class="source-publisher">Affirmation par : ${claim.claimant}</div>` : ''}`;
srcList.appendChild(div);
});
} else {
srcList.innerHTML = `<div class="no-sources">Aucune vérification formelle trouvée dans les bases de données Fact Check. Consultez AFP Factuel, CheckNews ou Les Décodeurs.</div>`;
}

// Indicateurs
const indList = document.getElementById('indicatorsList');
indList.innerHTML = '';
const allIndicators = [...local.indicators];
if (wikiResult.found) {
allIndicators.push(`✅ Page Wikipedia confirmée : "${wikiResult.pageTitle}" (${wikiResult.matchedTerms.length} terme(s) corroboré(s))`);
} else {
allIndicators.push('🔵 Aucune page Wikipedia directement correspondante');
}
if (factScore !== null) {
if (factScore < 30) allIndicators.push('❌ Affirmation répertoriée comme fausse par des fact-checkers');
else if (factScore > 70) allIndicators.push('✅ Affirmation confirmée par des fact-checkers reconnus');
}
allIndicators.slice(0, 5).forEach(ind => {
indList.innerHTML += `<div class="indicator-item">${ind}</div>`;
});

animateRing(score);
document.getElementById('results').classList.add('show');
document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function animateRing(score) {
const ring = document.getElementById('ringFill');
setTimeout(() => {
ring.style.strokeDashoffset = 232.5 - (score / 100) * 232.5;
}, 100);
let current = 0;
const step = () => {
current = Math.min(current + 2, score);
document.getElementById('scoreNum').textContent = current;
if (current < score) requestAnimationFrame(step);
};
requestAnimationFrame(step);
}

function fillExample(el) {
document.getElementById('inputText').value = el.textContent.trim();
document.getElementById('inputText').focus();
}

document.getElementById('inputText').addEventListener('keydown', e => {
if (e.key === 'Enter' && e.ctrlKey) analyzeText();
});
</script>
